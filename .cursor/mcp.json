    },
    "jupiter-docs": {
      "url": "https://developers.jup.ag/docs/mcp"
    },
    "phantom-docs": {
      "url": "https://docs.phantom.com/mcp"
    },
    "coinstats": {
      "url": "https://mcp.coinstats.app/mcp"
    },
    "cubic": {
      "type": "http",
      "url": "https://www.cubic.dev/api/mcp"
    }
  }
}
